# Supabase: project URL and publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix with NEXT_PUBLIC_.
# Used to provision temporary guest sessions and aggregate the ranking.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob private store.
BLOB_READ_WRITE_TOKEN=

# Vercel -> Google Cloud Tasks (OIDC / Workload Identity Federation).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_TASKS_LOCATION=
GOOGLE_CLOUD_TASKS_QUEUE=judo-analysis
GOOGLE_CLOUD_WORKER_URL=
GOOGLE_CLOUD_TASKS_SERVICE_ACCOUNT=
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# Worker ↔ web app shared secret for short-lived Blob URLs.
WORKER_API_SECRET=

# TTL cleanup cron. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
VIDEO_TTL_HOURS=24
